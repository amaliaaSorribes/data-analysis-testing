# Configuración de API Keys
# Copia este archivo a .env y configura tus tokens

# Proveedor de IA: "openai" o "github"
AI_PROVIDER=openai

# Token de OpenAI (si AI_PROVIDER=openai)
OPENAI_API_KEY=tu_token_de_openai_aqui

# Token de GitHub (si AI_PROVIDER=github)
# Genera tu token en: https://github.com/settings/tokens
GITHUB_TOKEN=tu_token_de_github_aqui
